# Postgres: either a full DATABASE_URL (wins if set) or the POSTGRES_* parts
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tagwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tagwise
POSTGRES_USER=
POSTGRES_PASSWORD=

# Clerk: same keys as the frontend (Clerk dashboard → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Origins allowed to mint session tokens (comma separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

CORS_ORIGINS=http://localhost:3000
