# Clerk (Clerk dashboard → API keys). Copy to .env.local.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Use the app's own sign-in/up pages (also read by proxy.ts redirects)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# FastAPI backend that /api/* is proxied to
API_URL=http://127.0.0.1:8000

# Public URL encoded in QR codes (use your LAN IP to scan from a phone)
# NEXT_PUBLIC_APP_URL=http://192.168.1.20:3000
