# Postgres: either a full DATABASE_URL (wins if set) or the POSTGRES_* parts
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tagwise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tagwise
POSTGRES_USER=
POSTGRES_PASSWORD=

# Clerk: same keys as the frontend (Clerk dashboard → API keys)
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Origins allowed to mint session tokens (comma separated)
CLERK_AUTHORIZED_PARTIES=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

# Photos: leave empty to store on local disk (backend/uploads). For production use an S3-compatible bucket:
# S3_ENDPOINT=https://<project>.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_BUCKET=photos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://<project>.supabase.co/storage/v1/object/public/photos
